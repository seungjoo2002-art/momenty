# MOMENTY 환경 변수 — 이 파일을 .env.local 로 복사해서 값을 채운다.
# .env.local 은 git에 올라가지 않는다 (.gitignore). 실제 값은 절대 커밋하지 않는다.
#
# Supabase 값은 필수다 (localStorage 대체 모드는 없다).

# ── Supabase (Project Settings → API) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# publishable key (sb_publishable_...) — 예전 프로젝트는 anon key를 대신 넣어도 된다
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service role(secret) key — seed 스크립트(npm run db:seed)에서만 쓴다.
# 서버 전용. 절대 NEXT_PUBLIC_ 을 붙이지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# ── 데모 계정 (seed · 테스트 전용) ─────────────────────────────────
# 앱 화면은 이 값을 읽지 않는다 — 사용자는 로그인 화면에서 직접 가입 · 로그인한다.
# npm run db:seed 가 이 이메일·비밀번호로 데모 계정을 만들고, npm run test:live 가 이 계정으로 권한을 검사한다.
# NEXT_PUBLIC_ 을 붙이지 않는다 (브라우저 번들에 들어가지 않도록).
DEMO_FAN_EMAIL=
DEMO_FAN_PASSWORD=
DEMO_CREATOR_EMAIL=
DEMO_CREATOR_PASSWORD=

# ── Creator AI (서버 전용 — 절대 NEXT_PUBLIC_ 을 붙이지 않는다) ─────────
# src/lib/ai/config.ts(server-only)만 읽는다. Client Component에서 import하면 빌드가 실패한다.
# v0.5-1: 아직 LLM을 호출하지 않는다 (비워 두면 /api/ai/chat 은 "provider_not_configured"로 응답).
# AI Route가 DB 함수(Persona Context · 대화 저장 · rate limit)를 부를 때 쓰는 서버 키 (48바이트 이상 무작위).
# DB의 private.server_keys에는 이 키의 SHA-256 해시만 넣는다 (README 참고).
AI_SERVER_KEY=
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# 요청 횟수 제한은 환경 변수가 아니라 DB(private.ai_settings)에서 관리한다 — 기본 user × creator 20 · user 60 · 600초.

# ── 결제 (아직 사용하지 않음) ─────────────────────────────────────
PAYMENT_SECRET_KEY=
NEXT_PUBLIC_PAYMENT_CLIENT_KEY=
