# MOMENTY 환경 변수 — 이 파일을 .env.local 로 복사해서 값을 채운다.
# .env.local 은 git에 올라가지 않는다 (.gitignore). 실제 값은 절대 커밋하지 않는다.
#
# Supabase 값이 비어 있으면 앱은 localStorage 기반 개발 모드로 동작한다.

# ── Supabase (Project Settings → API) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# publishable key (sb_publishable_...) — 예전 프로젝트는 anon key를 대신 넣어도 된다
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service role(secret) key — seed 스크립트(npm run db:seed)에서만 쓴다.
# 서버 전용. 절대 NEXT_PUBLIC_ 을 붙이지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# ── 데모 계정 (자동 로그인) ────────────────────────────────────────
# 로그인 화면을 Supabase Auth에 연결하기 전까지, 팬 모드 / Studio가 이 계정으로 자동 로그인한다.
# npm run db:seed 가 이 이메일·비밀번호로 계정을 만든다.
# ⚠ NEXT_PUBLIC_ 값은 브라우저에 그대로 노출된다 — 데모 전용 계정에만 쓰고, 실제 서비스에서는 비워 둔다.
NEXT_PUBLIC_DEMO_FAN_EMAIL=
NEXT_PUBLIC_DEMO_FAN_PASSWORD=
NEXT_PUBLIC_DEMO_CREATOR_EMAIL=
NEXT_PUBLIC_DEMO_CREATOR_PASSWORD=

# ── 다음 단계 (아직 사용하지 않음) ────────────────────────────────
# Creator AI (서버 전용 — 클라이언트에 노출 금지)
AI_API_KEY=
# 결제
PAYMENT_SECRET_KEY=
NEXT_PUBLIC_PAYMENT_CLIENT_KEY=
